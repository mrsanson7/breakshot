{
  "name": "breakshot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @breakshot/server --filter @breakshot/client run dev",
    "build": "pnpm --filter @breakshot/client run build && pnpm --filter @breakshot/server run build",
    "start": "pnpm --filter @breakshot/server run start",
    "serve": "pnpm build && pnpm --filter @breakshot/server run serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/shared && tsc -p packages/client && tsc -p packages/server"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
