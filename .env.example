# Game server (packages/server)
PORT=8787                 # listening port (dev: SERVER_PORT is also accepted)
HOST=0.0.0.0
STATIC_DIR=               # folder with the built client to serve; empty = WebSocket/API only
ALLOWED_ORIGINS=          # comma-separated Origin allow-list for WebSocket upgrades; empty = any
MAX_ROOMS=500
SWEEP_INTERVAL_MS=30000

# Client build (packages/client), only when client and server are on different origins
VITE_SERVER_URL=          # e.g. wss://game.example.com/ws
